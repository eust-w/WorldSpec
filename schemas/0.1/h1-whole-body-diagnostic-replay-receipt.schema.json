{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldspec.dev/schemas/0.1/h1-whole-body-diagnostic-replay-receipt.schema.json",
  "title": "WorldSpec H1 A5-CI Artifact Receipt 0.1",
  "type": "object",
  "required": [
    "id",
    "receiptVersion",
    "status",
    "attemptId",
    "artifactCopied",
    "artifacts",
    "generatedAt"
  ],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "receiptVersion": { "const": "0.1.0" },
    "status": { "const": "verified" },
    "attemptId": {
      "type": "string",
      "pattern": "^a5-ci-[a-z0-9][a-z0-9-]{2,63}$"
    },
    "artifactCopied": { "const": true },
    "artifacts": {
      "type": "object",
      "required": ["report", "controller", "trace", "equivalence"],
      "properties": {
        "report": { "$ref": "#/$defs/artifact" },
        "controller": { "$ref": "#/$defs/artifact" },
        "trace": { "$ref": "#/$defs/artifact" },
        "equivalence": { "$ref": "#/$defs/artifact" }
      },
      "additionalProperties": false
    },
    "generatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["path", "digest", "sizeBytes"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "not": { "pattern": "(^/|(^|/)\\.\\.(/|$))" }
        },
        "digest": { "$ref": "common.schema.json#/$defs/digest" },
        "sizeBytes": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
