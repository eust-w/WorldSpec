{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldspec.dev/schemas/0.1/h1-task-load-full-kitchen-single-report.schema.json",
  "title": "WorldSpec H1 Task-Load Full Kitchen Single Probe Report 0.1",
  "type": "object",
  "required": [
    "id",
    "reportVersion",
    "status",
    "scope",
    "executionEvidence",
    "runtimeAcceptance",
    "controllerStatus",
    "formalTaskLoadFullKitchenSingleGate",
    "probeDefinition",
    "imageSource",
    "probeInput",
    "container",
    "platform",
    "gpu",
    "packages",
    "packageLockDigest",
    "baseTrainingProfileDigest",
    "supervisorProfileDigest",
    "taskProfileDigest",
    "supervisorEvidence",
    "controlLineage",
    "policies",
    "staticPreflight",
    "runtimePreflight",
    "target",
    "scene",
    "controller",
    "qualityAssessment",
    "controllerArtifact",
    "traceArtifact",
    "claimBoundary",
    "logDiagnostics",
    "generatedAt"
  ],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "reportVersion": { "const": "0.1.0" },
    "status": { "const": "completed" },
    "scope": { "const": "h1_task_load_full_kitchen_single_probe" },
    "executionEvidence": { "const": "executed" },
    "runtimeAcceptance": { "const": "research_single_integration" },
    "controllerStatus": {
      "enum": ["single_integration_candidate", "non_publishable"]
    },
    "formalTaskLoadFullKitchenSingleGate": { "enum": ["passed", "failed"] },
    "probeDefinition": {
      "$ref": "h1-locomotion-midterm-report.schema.json#/$defs/revision"
    },
    "imageSource": {
      "$ref": "h1-locomotion-midterm-report.schema.json#/$defs/revision"
    },
    "probeInput": {
      "$ref": "h1-locomotion-dual-policy-report.schema.json#/$defs/probeInput"
    },
    "container": { "type": "object" },
    "platform": { "type": "object" },
    "gpu": { "type": "object" },
    "packages": { "type": "object" },
    "packageLockDigest": { "$ref": "common.schema.json#/$defs/digest" },
    "baseTrainingProfileDigest": { "$ref": "common.schema.json#/$defs/digest" },
    "supervisorProfileDigest": { "$ref": "common.schema.json#/$defs/digest" },
    "taskProfileDigest": { "$ref": "common.schema.json#/$defs/digest" },
    "supervisorEvidence": { "type": "object" },
    "controlLineage": { "type": "object" },
    "taskSceneHandoffEvidence": { "type": "object" },
    "taskSceneArmRecoveryEvidence": { "type": "object" },
    "policies": {
      "type": "object",
      "required": ["motion", "capture", "stand"],
      "additionalProperties": { "type": "object" }
    },
    "staticPreflight": { "type": "object" },
    "runtimePreflight": { "type": "object" },
    "target": { "type": "object" },
    "scene": { "type": "object" },
    "controller": { "type": "object" },
    "qualityAssessment": {
      "type": "object",
      "required": ["status", "singleRunGate", "tests"],
      "properties": {
        "status": { "enum": ["passed", "failed"] },
        "singleRunGate": { "type": "boolean" },
        "tests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "result", "metrics"],
            "properties": {
              "id": { "$ref": "common.schema.json#/$defs/id" },
              "result": { "enum": ["pass", "fail"] },
              "metrics": { "type": "object" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "controllerArtifact": {
      "$ref": "h1-locomotion-dual-policy-report.schema.json#/$defs/artifact"
    },
    "traceArtifact": {
      "$ref": "h1-locomotion-dual-policy-report.schema.json#/$defs/artifact"
    },
    "claimBoundary": {
      "type": "object",
      "required": ["status", "fiveRunClaim", "l3Claim", "reasons"],
      "properties": {
        "status": { "const": "research_single_integration_only" },
        "fiveRunClaim": { "const": "forbidden" },
        "l3Claim": { "const": "forbidden" },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "logDiagnostics": {
      "$ref": "h1-locomotion-dual-policy-report.schema.json#/$defs/logDiagnostics"
    },
    "generatedAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "formalTaskLoadFullKitchenSingleGate": { "const": "passed" }
        },
        "required": ["formalTaskLoadFullKitchenSingleGate"]
      },
      "then": {
        "properties": {
          "controllerStatus": { "const": "single_integration_candidate" },
          "qualityAssessment": {
            "properties": {
              "status": { "const": "passed" },
              "singleRunGate": { "const": true },
              "tests": {
                "items": {
                  "properties": { "result": { "const": "pass" } }
                }
              }
            }
          },
          "logDiagnostics": {
            "properties": {
              "ccdOverflowCount": { "const": 0 },
              "capacityOverflowCount": { "const": 0 },
              "abnormalContactCount": { "const": 0 },
              "jointLimitViolationCount": { "const": 0 },
              "nonFiniteCount": { "const": 0 },
              "clean": { "const": true }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
