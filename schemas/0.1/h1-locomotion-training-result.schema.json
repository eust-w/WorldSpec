{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldspec.dev/schemas/0.1/h1-locomotion-training-result.schema.json",
  "title": "WorldSpec H1 Locomotion Training Result 0.1",
  "type": "object",
  "required": [
    "id",
    "resultVersion",
    "trainingProfileDigest",
    "targetBundleDigest",
    "status",
    "executionEvidence",
    "artifacts",
    "tests",
    "diagnostics",
    "generatedAt"
  ],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "resultVersion": { "$ref": "common.schema.json#/$defs/semver" },
    "trainingProfileDigest": { "$ref": "common.schema.json#/$defs/digest" },
    "targetBundleDigest": { "$ref": "common.schema.json#/$defs/digest" },
    "status": { "enum": ["succeeded", "failed", "blocked"] },
    "executionEvidence": { "enum": ["executed", "not_executed"] },
    "policyStatus": { "enum": ["policy_candidate", "non_publishable"] },
    "runtime": {
      "type": "object",
      "required": [
        "containerDigest",
        "packageLockDigest",
        "backendPackage",
        "backendVersion",
        "device"
      ],
      "properties": {
        "containerDigest": { "$ref": "common.schema.json#/$defs/digest" },
        "packageLockDigest": { "$ref": "common.schema.json#/$defs/digest" },
        "backendPackage": { "const": "worldspec_h1_training" },
        "backendVersion": { "$ref": "common.schema.json#/$defs/semver" },
        "device": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/artifactRef" }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "result", "metrics"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "result": { "enum": ["pass", "fail", "unknown", "not_run"] },
          "metrics": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/diagnostic" }
    },
    "executionContext": { "type": "object" },
    "generatedAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "succeeded" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "executionEvidence": { "const": "executed" },
          "artifacts": {
            "minItems": 4,
            "allOf": [
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "role": { "const": "orbax_checkpoint_archive" }
                  },
                  "required": ["role"]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "properties": { "role": { "const": "policy_manifest" } },
                  "required": ["role"]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "properties": { "role": { "const": "evaluation_traces" } },
                  "required": ["role"]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "properties": { "role": { "const": "environment_lock" } },
                  "required": ["role"]
                },
                "minContains": 1,
                "maxContains": 1
              }
            ]
          },
          "tests": {
            "minItems": 5,
            "maxItems": 10,
            "items": {
              "properties": { "result": { "const": "pass" } }
            }
          },
          "policyStatus": { "const": "policy_candidate" }
        },
        "required": ["runtime", "policyStatus"]
      }
    },
    {
      "if": {
        "properties": { "executionEvidence": { "const": "executed" } },
        "required": ["executionEvidence"]
      },
      "then": {
        "properties": {
          "artifacts": { "minItems": 4 },
          "tests": { "minItems": 5, "maxItems": 10 }
        },
        "required": ["runtime", "policyStatus"]
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "failed" },
          "executionEvidence": { "const": "executed" }
        },
        "required": ["status", "executionEvidence"]
      },
      "then": {
        "properties": {
          "policyStatus": { "const": "non_publishable" }
        },
        "required": ["runtime", "policyStatus"]
      }
    },
    {
      "if": {
        "properties": { "executionEvidence": { "const": "not_executed" } },
        "required": ["executionEvidence"]
      },
      "then": {
        "properties": {
          "status": { "const": "blocked" },
          "artifacts": { "maxItems": 0 },
          "tests": { "maxItems": 0 },
          "diagnostics": { "minItems": 1 }
        }
      }
    }
  ],
  "additionalProperties": false
}
