{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldspec.dev/schemas/0.1/conformance-report.schema.json",
  "title": "WorldSpec ConformanceReport 0.1",
  "type": "object",
  "required": [
    "id",
    "reportVersion",
    "buildManifestDigest",
    "environment",
    "tests",
    "summary"
  ],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "reportVersion": { "$ref": "common.schema.json#/$defs/semver" },
    "buildManifestDigest": { "$ref": "common.schema.json#/$defs/digest" },
    "environment": {
      "type": "object",
      "required": ["os", "architecture", "runtime", "runtimeVersion"],
      "properties": {
        "os": { "type": "string" },
        "architecture": { "type": "string" },
        "runtime": { "type": "string" },
        "runtimeVersion": { "type": "string" },
        "hardware": { "type": "string" }
      },
      "additionalProperties": false
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version", "result", "evidenceArtifacts"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "version": { "type": "string" },
          "result": { "enum": ["pass", "fail", "unknown", "not_run"] },
          "metrics": { "type": "object" },
          "tolerances": { "type": "object" },
          "evidenceArtifacts": {
            "type": "array",
            "items": { "$ref": "common.schema.json#/$defs/artifactRef" }
          },
          "diagnostics": {
            "type": "array",
            "items": { "$ref": "common.schema.json#/$defs/diagnostic" }
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "summary": {
      "type": "object",
      "required": ["passed", "failed", "unknown", "notRun", "overall"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "unknown": { "type": "integer", "minimum": 0 },
        "notRun": { "type": "integer", "minimum": 0 },
        "overall": { "enum": ["pass", "fail", "incomplete"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
