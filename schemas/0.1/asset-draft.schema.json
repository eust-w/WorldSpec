{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldspec.dev/schemas/0.1/asset-draft.schema.json",
  "title": "WorldSpec AssetDraft 0.1",
  "type": "object",
  "required": [
    "id",
    "specVersion",
    "sourceBundle",
    "status",
    "diagnostics",
    "unresolved"
  ],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "specVersion": { "const": "0.1.0" },
    "sourceBundle": { "$ref": "source-bundle.schema.json" },
    "status": { "enum": ["draft", "needs_review", "ready_for_validation", "rejected"] },
    "candidateWorldDefinition": {
      "oneOf": [
        { "$ref": "world-definition.schema.json" },
        {
          "type": "object",
          "required": ["digest"],
          "properties": {
            "digest": { "$ref": "common.schema.json#/$defs/digest" }
          },
          "additionalProperties": false
        }
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/diagnostic" }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "question", "impact"],
        "properties": {
          "code": { "type": "string" },
          "question": { "type": "string" },
          "impact": { "enum": ["low", "medium", "high", "blocking"] }
        },
        "additionalProperties": false
      }
    },
    "generator": {
      "type": "object",
      "required": ["backend", "version", "profileDigest"],
      "properties": {
        "backend": { "type": "string" },
        "version": { "type": "string" },
        "profileDigest": { "$ref": "common.schema.json#/$defs/digest" }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "ready_for_validation" } },
        "required": ["status"]
      },
      "then": { "required": ["candidateWorldDefinition"] }
    }
  ],
  "additionalProperties": false
}
