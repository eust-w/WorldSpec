{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldspec.dev/schemas/0.1/asset-draft.schema.json",
  "title": "WorldSpec AssetDraft 0.1",
  "$defs": {
    "sourceItem": {
      "type": "object",
      "required": ["id", "digest", "mediaType", "format", "rightsStatus"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "digest": { "$ref": "common.schema.json#/$defs/digest" },
        "mediaType": { "type": "string", "minLength": 1 },
        "format": {
          "enum": [
            "glb",
            "obj",
            "urdf",
            "mjcf",
            "step",
            "iges",
            "openusd",
            "image",
            "image_set",
            "video"
          ]
        },
        "rightsStatus": {
          "enum": ["cleared", "restricted", "review_required", "unknown"]
        }
      },
      "additionalProperties": false
    },
    "sourceBundle": {
      "type": "object",
      "required": ["id", "items", "bundleDigest"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourceItem" },
          "minItems": 1
        },
        "bundleDigest": { "$ref": "common.schema.json#/$defs/digest" },
        "nativePayloads": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/nativePayload" }
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "id",
    "specVersion",
    "sourceBundle",
    "status",
    "candidateWorldDefinition",
    "diagnostics",
    "unresolved"
  ],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "specVersion": { "const": "0.1.0" },
    "sourceBundle": { "$ref": "#/$defs/sourceBundle" },
    "status": { "enum": ["draft", "needs_review", "ready_for_validation", "rejected"] },
    "candidateWorldDefinition": {
      "oneOf": [
        { "$ref": "world-definition.schema.json" },
        {
          "type": "object",
          "required": ["digest"],
          "properties": {
            "digest": { "$ref": "common.schema.json#/$defs/digest" }
          },
          "additionalProperties": false
        }
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/diagnostic" }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "question", "impact"],
        "properties": {
          "code": { "type": "string" },
          "question": { "type": "string" },
          "impact": { "enum": ["low", "medium", "high", "blocking"] }
        },
        "additionalProperties": false
      }
    },
    "generator": {
      "type": "object",
      "required": ["backend", "version", "profileDigest"],
      "properties": {
        "backend": { "type": "string" },
        "version": { "type": "string" },
        "profileDigest": { "$ref": "common.schema.json#/$defs/digest" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
