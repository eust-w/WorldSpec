{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldspec.dev/schemas/0.1/h1-locomotion-supervisor-report.schema.json",
  "title": "WorldSpec H1 Phase-Aware Supervisor Probe Report 0.1",
  "type": "object",
  "required": [
    "id",
    "reportVersion",
    "status",
    "scope",
    "executionEvidence",
    "runtimeAcceptance",
    "controllerStatus",
    "formalSupervisorGate",
    "probeDefinition",
    "imageSource",
    "probeInput",
    "container",
    "platform",
    "gpu",
    "packages",
    "packageLockDigest",
    "baseTrainingProfileDigest",
    "supervisorProfileDigest",
    "motionPolicy",
    "capturePolicy",
    "standPolicy",
    "runtimeCapacity",
    "staticPreflight",
    "runtimePreflight",
    "target",
    "supervisor",
    "qualityAssessment",
    "controllerArtifact",
    "traceArtifact",
    "logDiagnostics",
    "generatedAt"
  ],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "reportVersion": { "const": "0.1.0" },
    "status": { "const": "completed" },
    "scope": { "const": "h1_phase_aware_supervisor_probe" },
    "executionEvidence": { "const": "executed" },
    "runtimeAcceptance": { "const": "research_supervisor" },
    "controllerStatus": {
      "enum": ["supervisor_candidate", "non_publishable"]
    },
    "formalSupervisorGate": { "enum": ["passed", "failed"] },
    "probeDefinition": {
      "$ref": "h1-locomotion-midterm-report.schema.json#/$defs/revision"
    },
    "imageSource": {
      "$ref": "h1-locomotion-midterm-report.schema.json#/$defs/revision"
    },
    "probeInput": {
      "$ref": "h1-locomotion-dual-policy-report.schema.json#/$defs/probeInput"
    },
    "container": { "type": "object" },
    "platform": { "type": "object" },
    "gpu": { "type": "object" },
    "packages": { "type": "object" },
    "packageLockDigest": { "$ref": "common.schema.json#/$defs/digest" },
    "baseTrainingProfileDigest": { "$ref": "common.schema.json#/$defs/digest" },
    "supervisorProfileDigest": { "$ref": "common.schema.json#/$defs/digest" },
    "motionPolicy": { "$ref": "#/$defs/policyInitialization" },
    "capturePolicy": { "$ref": "#/$defs/policyInitialization" },
    "standPolicy": { "$ref": "#/$defs/policyInitialization" },
    "runtimeCapacity": { "type": "object" },
    "staticPreflight": { "type": "object" },
    "runtimePreflight": { "type": "object" },
    "target": {
      "$ref": "h1-locomotion-dual-policy-report.schema.json#/$defs/target"
    },
    "supervisor": { "type": "object" },
    "qualityAssessment": {
      "type": "object",
      "required": ["status", "deterministicSuiteGate", "tests"],
      "properties": {
        "status": { "enum": ["passed", "failed"] },
        "deterministicSuiteGate": { "type": "boolean" },
        "tests": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "$ref": "h1-locomotion-midterm-report.schema.json#/$defs/test"
          }
        }
      },
      "additionalProperties": false
    },
    "controllerArtifact": {
      "$ref": "h1-locomotion-dual-policy-report.schema.json#/$defs/artifact"
    },
    "traceArtifact": {
      "$ref": "h1-locomotion-dual-policy-report.schema.json#/$defs/artifact"
    },
    "logDiagnostics": {
      "$ref": "h1-locomotion-dual-policy-report.schema.json#/$defs/logDiagnostics"
    },
    "generatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "policyInitialization": {
      "allOf": [
        {
          "$ref": "h1-locomotion-dual-policy-report.schema.json#/$defs/policyInitialization"
        },
        {
          "properties": {
            "role": {
              "enum": ["motion", "motion_state_capture", "zero_velocity_and_stand"]
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "formalSupervisorGate": { "const": "passed" } },
        "required": ["formalSupervisorGate"]
      },
      "then": {
        "properties": {
          "controllerStatus": { "const": "supervisor_candidate" },
          "qualityAssessment": {
            "properties": {
              "status": { "const": "passed" },
              "deterministicSuiteGate": { "const": true },
              "tests": {
                "not": {
                  "contains": {
                    "properties": { "result": { "const": "fail" } },
                    "required": ["result"]
                  }
                }
              }
            }
          },
          "logDiagnostics": {
            "properties": {
              "ccdOverflowCount": { "const": 0 },
              "capacityOverflowCount": { "const": 0 },
              "abnormalContactCount": { "const": 0 },
              "jointLimitViolationCount": { "const": 0 },
              "nonFiniteCount": { "const": 0 },
              "clean": { "const": true }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
