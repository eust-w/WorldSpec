        "blendSteps": 5,
        "policyObservationCommandDuringHandoff": [0.0, 0.0, 0.0],
        "motionReentry": "allowed_above_entry_threshold"
      }
    },
    "runtime": {
      "type": "object",
      "required": [
        "containerImage",
        "containerDigest",
        "packageLockDigest",
        "ccdIterations",
        "evaluationEnvironments",
        "mjxCapacity"
      ],
      "properties": {
        "containerImage": {
          "type": "string",
          "pattern": "^\\S+@sha256:[0-9a-f]{64}$"
        },
        "containerDigest": { "$ref": "common.schema.json#/$defs/digest" },
        "packageLockDigest": {
          "const": "sha256:7cc88f20b2c608d6fe673f3b994b879db69d75361206bf25f949d7acc5ed3a41"
        },
        "ccdIterations": { "const": 50 },
        "evaluationEnvironments": { "const": 1 },
        "mjxCapacity": {
          "const": {
            "activeContactsPerEnvironment": 32,
            "ccdContactsPerEnvironment": 16,
            "njmax": 128
          }
        }
      },
      "additionalProperties": false
    },
    "artifactPolicy": {
      "const": {
        "controller": "research_only",
        "distribution": "internal_only",
        "fullTaskClaim": "forbidden",
        "l3Claim": "forbidden"
      }
    }
  },
  "dependentRequired": {
    "diagnosticEvidence": ["taskPolicyHandoff"],
    "taskPolicyHandoff": ["diagnosticEvidence"]
  },
  "additionalProperties": false
}
