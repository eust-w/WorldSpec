{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldspec.dev/schemas/0.1/h1-locomotion-adapter.schema.json",
  "title": "WorldSpec H1 Locomotion Adapter Profile 0.1",
  "type": "object",
  "required": [
    "id",
    "profileVersion",
    "sourceLockDigest",
    "policy",
    "sourceConfig",
    "simulation",
    "legControl",
    "observation",
    "upperBodyHold",
    "gripperControls",
    "validation",
    "evidenceStatus"
  ],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "profileVersion": { "$ref": "common.schema.json#/$defs/semver" },
    "sourceLockDigest": { "$ref": "common.schema.json#/$defs/digest" },
    "policy": { "$ref": "#/$defs/lockedFile" },
    "sourceConfig": { "$ref": "#/$defs/lockedFile" },
    "simulation": {
      "type": "object",
      "required": ["timestepSeconds", "controlDecimation", "durationSeconds"],
      "properties": {
        "timestepSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "controlDecimation": { "type": "integer", "minimum": 1 },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "legControl": {
      "type": "object",
      "required": [
        "joints",
        "actuators",
        "kps",
        "kds",
        "defaultAngles",
        "actionScale",
        "command"
      ],
      "properties": {
        "joints": { "$ref": "#/$defs/nameArray" },
        "actuators": { "$ref": "#/$defs/nameArray" },
        "kps": { "$ref": "#/$defs/numberArray" },
        "kds": { "$ref": "#/$defs/numberArray" },
        "defaultAngles": { "$ref": "#/$defs/numberArray" },
        "actionScale": { "type": "number", "exclusiveMinimum": 0 },
        "command": {
          "type": "array",
          "prefixItems": [
            { "type": "number" },
            { "type": "number" },
            { "type": "number" }
          ],
          "items": false
        }
      },
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "required": [
        "actions",
        "dimensions",
        "angularVelocityScale",
        "jointPositionScale",
        "jointVelocityScale",
        "commandScale",
        "phasePeriodSeconds"
      ],
      "properties": {
        "actions": { "type": "integer", "minimum": 1 },
        "dimensions": { "type": "integer", "minimum": 1 },
        "angularVelocityScale": { "type": "number" },
        "jointPositionScale": { "type": "number" },
        "jointVelocityScale": { "type": "number" },
        "commandScale": {
          "type": "array",
          "prefixItems": [
            { "type": "number" },
            { "type": "number" },
            { "type": "number" }
          ],
          "items": false
        },
        "phasePeriodSeconds": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "upperBodyHold": {
      "type": "object",
      "required": ["joints", "actuators", "targets", "kps", "kds"],
      "properties": {
        "joints": { "$ref": "#/$defs/nameArray" },
        "actuators": { "$ref": "#/$defs/nameArray" },
        "targets": { "$ref": "#/$defs/numberArray" },
        "kps": { "$ref": "#/$defs/numberArray" },
        "kds": { "$ref": "#/$defs/numberArray" }
      },
      "additionalProperties": false
    },
    "gripperControls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["actuator", "value"],
        "properties": {
          "actuator": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "value": { "type": "number" }
        },
        "additionalProperties": false
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "minimumBaseHeight",
        "minimumUprightCosine",
        "minimumForwardDisplacement",
        "maximumLateralDrift"
      ],
      "properties": {
        "minimumBaseHeight": { "type": "number", "minimum": 0 },
        "minimumUprightCosine": { "type": "number", "minimum": -1, "maximum": 1 },
        "minimumForwardDisplacement": { "type": "number", "minimum": 0 },
        "maximumLateralDrift": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "evidenceStatus": { "$ref": "common.schema.json#/$defs/evidenceStatus" },
    "profileDigest": { "$ref": "common.schema.json#/$defs/digest" }
  },
  "$defs": {
    "lockedFile": {
      "type": "object",
      "required": ["componentId", "path", "digest"],
      "properties": {
        "componentId": { "$ref": "common.schema.json#/$defs/id" },
        "path": {
          "type": "string",
          "minLength": 1,
          "not": { "pattern": "(^/|(^|/)\\.\\.(/|$))" }
        },
        "digest": { "$ref": "common.schema.json#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "nameArray": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "numberArray": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
