    "checkpointSelection": {
      "type": "object",
      "required": [
        "mode",
        "evaluateAllSavedCheckpoints",
        "expectedCandidateCount",
        "memoryIsolation",
        "selectedStep",
        "selectedFormalGate",
        "candidates"
      ],
      "properties": {
        "mode": {
          "const": "formal_gate_then_pass_count_then_episode_length"
        },
        "evaluateAllSavedCheckpoints": {
          "const": true
        },
        "expectedCandidateCount": {
          "const": 7
        },
        "memoryIsolation": {
          "const": "training_and_suite_evaluation_process_boundary_v4"
        },
        "selectedStep": {
          "enum": [
            2457600,
            4915200,
            7372800,
            9830400,
            12288000,
            14745600,
            17203200
          ]
        },
        "selectedFormalGate": {
          "type": "boolean"
        },
        "candidates": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/checkpointCandidate"
          },
          "allOf": [
            {
              "contains": {
                "properties": {
                  "step": {
                    "const": 2457600
                  }
                },
                "required": [
                  "step"
                ]
              }
            },
            {
              "contains": {
                "properties": {
                  "step": {
                    "const": 4915200
                  }
                },
                "required": [
                  "step"
                ]
              }
            },
            {
              "contains": {
                "properties": {
                  "step": {
                    "const": 7372800
                  }
                },
                "required": [
                  "step"
                ]
              }
            },
            {
              "contains": {
                "properties": {
                  "step": {
                    "const": 9830400
                  }
                },
                "required": [
                  "step"
                ]
              }
            },
            {
              "contains": {
                "properties": {
                  "step": {
                    "const": 12288000
                  }
                },
                "required": [
                  "step"
                ]
              }
            },
            {
              "contains": {
                "properties": {
                  "step": {
                    "const": 14745600
                  }
                },
                "required": [
                  "step"
                ]
              }
            },
            {
              "contains": {
                "properties": {
                  "step": {
                    "const": 17203200
                  }
                },
                "required": [
                  "step"
                ]
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "snapshotBank": {
      "type": "object",
      "required": [
        "path",
        "digest",
        "sizeBytes",
        "distribution",
        "snapshotCount",
        "motionSteps",
        "captureStepMinimum",
        "captureStepMaximum",
        "motionCommandMinimum",
        "motionCommandMaximum",
        "terminatedSnapshotCount",
        "seed"
      ],
      "properties": {
        "path": {
          "const": "manipulation-state-bank.npz"
        },
        "digest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1
        },
        "distribution": {
          "const": "internal_only"
        },
        "snapshotCount": {
          "const": 4096
        },
        "motionSteps": {
          "const": 150
        },
        "captureStepMinimum": {
          "type": "integer",
          "minimum": 35,
          "maximum": 50
        },
        "captureStepMaximum": {
          "type": "integer",
          "minimum": 35,
          "maximum": 50
        },
        "motionCommandMinimum": {
          "$ref": "#/$defs/vector3"
        },
        "motionCommandMaximum": {
          "$ref": "#/$defs/vector3"
        },
        "terminatedSnapshotCount": {
          "const": 0
        },
        "seed": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "runtimeCapacity": {
      "type": "object"
    },
    "staticPreflight": {
      "type": "object"
    },
    "runtimePreflight": {
      "type": "object"
    },
    "target": {
      "$ref": "h1-locomotion-dual-policy-report.schema.json#/$defs/target"
    },
    "training": {
      "type": "object",
      "required": [
        "profileStage",
        "progressRecordCount",
        "maximumReportedStep",
        "elapsedSeconds",
        "firstProgress",
        "finalProgress"
      ],
      "properties": {
        "profileStage": {
          "const": "loaded_track_settle_manipulation_balance"
        },
        "progressRecordCount": {
          "type": "integer",
          "minimum": 2
        },
        "maximumReportedStep": {
          "type": "integer",
          "minimum": 1
        },
        "elapsedSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "firstProgress": {
          "type": "object"
        },
        "finalProgress": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "qualityAssessment": {
      "type": "object",
      "required": [
        "status",
        "finalMeanEpisodeLength",
        "minimumFinalMeanEpisodeLength",
        "meanEpisodeLengthGate",
        "deterministicSuiteGate",
        "tests"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "finalMeanEpisodeLength": {
          "type": "number"
        },
        "minimumFinalMeanEpisodeLength": {
          "const": 90.0
        },
        "meanEpisodeLengthGate": {
          "type": "boolean"
        },
        "deterministicSuiteGate": {
          "type": "boolean"
        },
        "tests": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/test"
          }
        }
      },
      "additionalProperties": false
    },
    "researchCheckpoint": {
      "$ref": "#/$defs/artifact"
    },
    "traceArtifact": {
      "$ref": "#/$defs/artifact"
    },
    "dynamicArmCurriculum": {
      "type": "object"
    },
    "logDiagnostics": {
      "$ref": "h1-locomotion-dual-policy-report.schema.json#/$defs/logDiagnostics"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "initialization": {
      "type": "object",
      "required": [
        "archiveDigest",
        "archiveSizeBytes",
        "selectedStep",
        "networkConfig",
        "restored",
        "optimizerState"
      ],
      "properties": {
        "archiveDigest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "archiveSizeBytes": {
          "type": "integer",
          "minimum": 1
        },
        "selectedStep": {
          "type": "integer",
          "minimum": 0
        },
        "networkConfig": {
          "type": "object"
        },
        "restored": {
          "type": "object",
          "required": [
            "normalizer",
            "policy",
            "value",
            "optimizer"
          ],
          "properties": {
            "normalizer": {
              "const": true
            },
            "policy": {
              "const": true
            },
            "value": {
              "const": true
            },
            "optimizer": {
              "const": false
            }
          },
          "additionalProperties": false
        },
        "optimizerState": {
          "const": "reset"
        },
        "mode": {
          "type": "string"
        },
        "selectedRole": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "digest",
        "sizeBytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "(^/|(^|/)\\.\\.(/|$))"
          }
        },
        "digest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1
        },
        "distribution": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "test": {
      "type": "object",
      "required": [
        "id",
        "suite",
        "result",
        "metrics"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "suite": {
          "enum": [
            "post_walk_capture",
            "from_rest"
          ]
        },
        "result": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "metrics": {
          "type": "object",
          "required": [
            "completedSteps",
            "requiredSteps",
            "minimumBaseHeight",
            "minimumUprightCosine",
            "maximumBaseTranslation",
            "maximumBaseLateralDrift",
            "maximumTerminalLinearSpeed",
            "maximumTerminalAngularSpeed",
            "nonFiniteSamples",
            "doneSeen",
            "terminalReasons"
          ]
        }
      },
      "additionalProperties": false
    },
    "checkpointCandidate": {
      "type": "object",
      "required": [
        "step",
        "meanEpisodeLength",
        "meanEpisodeLengthGate",
        "testsPassed",
        "testsRequired",
        "postWalkTestsPassed",
        "fromRestTestsPassed",
        "deterministicSuiteGate",
        "formalGate"
      ],
      "properties": {
        "step": {
          "enum": [
            2457600,
            4915200,
            7372800,
            9830400,
            12288000,
            14745600,
            17203200
          ]
        },
        "meanEpisodeLength": {
          "type": "number"
        },
        "meanEpisodeLengthGate": {
          "type": "boolean"
        },
        "testsPassed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "testsRequired": {
          "const": 10
        },
        "postWalkTestsPassed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "fromRestTestsPassed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "deterministicSuiteGate": {
          "type": "boolean"
        },
        "formalGate": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "formalManipulationBalanceGate": {
            "const": "passed"
          }
        },
        "required": [
          "formalManipulationBalanceGate"
        ]
      },
      "then": {
        "properties": {
          "policyStatus": {
            "const": "manipulation_balance_candidate"
          },
          "checkpointSelection": {
            "properties": {
              "selectedFormalGate": {
                "const": true
              }
            }
          },
          "qualityAssessment": {
            "properties": {
              "status": {
                "const": "passed"
              },
              "meanEpisodeLengthGate": {
                "const": true
              },
              "deterministicSuiteGate": {
                "const": true
              },
              "tests": {
                "not": {
                  "contains": {
                    "properties": {
                      "result": {
                        "const": "fail"
                      }
                    },
                    "required": [
                      "result"
                    ]
                  }
                }
              }
            }
          },
          "logDiagnostics": {
            "properties": {
              "clean": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "formalManipulationBalanceGate": {
            "const": "failed"
          }
        },
        "required": [
          "formalManipulationBalanceGate"
        ]
      },
      "then": {
        "properties": {
          "policyStatus": {
            "const": "non_publishable"
          },
          "checkpointSelection": {
            "properties": {
              "selectedFormalGate": {
                "const": false
              }
            }
          },
          "qualityAssessment": {
            "properties": {
              "status": {
                "const": "failed"
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
