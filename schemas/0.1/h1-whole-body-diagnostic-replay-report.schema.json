{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldspec.dev/schemas/0.1/h1-whole-body-diagnostic-replay-report.schema.json",
  "title": "WorldSpec H1 A5-CI Diagnostic Replay Report 0.1",
  "type": "object",
  "required": [
    "id",
    "reportVersion",
    "status",
    "scope",
    "executionEvidence",
    "runtimeAcceptance",
    "attemptId",
    "replayProfileDigest",
    "baseControlProfileDigest",
    "formalDiagnosticReplayGate",
    "formalControlGate",
    "controllerStatus",
    "originalTerminationReason",
    "replayTerminationReasons",
    "diagnosticCompleteness",
    "equivalenceAssessment",
    "artifactTransferStatus",
    "probeDefinition",
    "imageSource",
    "probeInput",
    "container",
    "platform",
    "gpu",
    "packages",
    "packageLockDigest",
    "baseTrainingProfileDigest",
    "supervisorProfileDigest",
    "controlProfileDigest",
    "policies",
    "staticPreflight",
    "runtimePreflight",
    "target",
    "scene",
    "controller",
    "qualityAssessment",
    "controllerArtifact",
    "traceArtifact",
    "equivalenceArtifact",
    "claimBoundary",
    "logDiagnostics",
    "generatedAt"
  ],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "reportVersion": { "const": "0.1.0" },
    "status": { "const": "completed" },
    "scope": {
      "const": "h1_whole_body_task_space_control_diagnostic_replay"
    },
    "executionEvidence": { "const": "executed" },
    "runtimeAcceptance": { "const": "diagnostic_replay" },
    "attemptId": {
      "type": "string",
      "pattern": "^a5-ci-[a-z0-9][a-z0-9-]{2,63}$"
    },
    "replayProfileDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "baseControlProfileDigest": {
      "const": "sha256:84175bdeb52d0b9a9122888e36f8bbd9fd42ccf79adb5c5534f16a5d74d787fd"
    },
    "formalDiagnosticReplayGate": { "enum": ["passed", "failed"] },
    "formalControlGate": { "enum": ["passed", "failed"] },
    "controllerStatus": { "const": "non_publishable" },
    "originalTerminationReason": { "const": "unknown" },
    "replayTerminationReasons": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/terminationReason" }
    },
    "diagnosticCompleteness": {
      "type": "object",
      "required": [
        "status",
        "reasons",
        "recordCount",
        "terminalReasons",
        "terminalJoints",
        "controlSaturationSamples",
        "maximumControlUtilization"
      ],
      "properties": {
        "status": { "enum": ["passed", "failed"] },
        "reasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "recordCount": { "type": "integer", "minimum": 1 },
        "terminalReasons": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/terminationReason" }
        },
        "terminalJoints": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          }
        },
        "controlSaturationSamples": { "type": "integer", "minimum": 0 },
        "maximumControlUtilization": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "equivalenceAssessment": {
      "type": "object",
      "required": ["status", "reportDigest", "staticSemanticEquivalent"],
      "properties": {
        "status": { "enum": ["passed", "failed"] },
        "reportDigest": { "$ref": "common.schema.json#/$defs/digest" },
        "staticSemanticEquivalent": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "artifactTransferStatus": { "enum": ["pending", "passed"] },
    "probeDefinition": {
      "$ref": "h1-locomotion-midterm-report.schema.json#/$defs/revision"
    },
    "imageSource": {
      "$ref": "h1-locomotion-midterm-report.schema.json#/$defs/revision"
    },
    "probeInput": {
      "$ref": "h1-locomotion-dual-policy-report.schema.json#/$defs/probeInput"
    },
    "container": { "type": "object" },
    "platform": { "type": "object" },
    "gpu": { "type": "object" },
    "packages": { "type": "object" },
    "packageLockDigest": { "$ref": "common.schema.json#/$defs/digest" },
    "baseTrainingProfileDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "supervisorProfileDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "controlProfileDigest": {
      "const": "sha256:84175bdeb52d0b9a9122888e36f8bbd9fd42ccf79adb5c5534f16a5d74d787fd"
    },
    "policies": {
      "type": "object",
      "required": ["motion", "capture", "stand"],
      "additionalProperties": { "type": "object" }
    },
    "staticPreflight": { "type": "object" },
    "runtimePreflight": { "type": "object" },
    "target": {
      "const": {
        "sourceBundleDigest": "sha256:07e8122f3c922c1ae65e3eca17c34af4cb7a5e92dc926ecb07da9fdbda95938b",
        "derivedModelDigest": "sha256:e43323d01a65d22d937d6d908222db7e13d4f4ef432564f4b129d949d5d6b43b",
        "observationSize": 42,
        "actionSize": 10
      }
    },
    "scene": {
      "$ref": "h1-kitchen-task-profile.schema.json#/properties/scene"
    },
    "controller": {
      "$ref": "h1-whole-body-control-profile.schema.json#/properties/controller"
    },
    "qualityAssessment": {
      "$ref": "h1-whole-body-control-report.schema.json#/properties/qualityAssessment"
    },
    "controllerArtifact": { "$ref": "#/$defs/internalArtifact" },
    "traceArtifact": { "$ref": "#/$defs/internalArtifact" },
    "equivalenceArtifact": { "$ref": "#/$defs/internalArtifact" },
    "claimBoundary": {
      "const": {
        "status": "diagnostic_replay_only",
        "originalA5CRootCause": "unknown",
        "retroactiveRootCauseClaim": "forbidden",
        "controllerCandidateClaim": "forbidden",
        "fullTaskClaim": "forbidden",
        "l3Claim": "forbidden",
        "fiveRunGate": "not_executed",
        "formalTraining": "not_started"
      }
    },
    "logDiagnostics": {
      "$ref": "h1-locomotion-dual-policy-report.schema.json#/$defs/logDiagnostics"
    },
    "generatedAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "qualityAssessment": {
            "properties": {
              "tests": {
                "contains": {
                  "properties": {
                    "metrics": {
                      "properties": { "doneSeen": { "const": true } },
                      "required": ["doneSeen"]
                    }
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "replayTerminationReasons": { "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "formalDiagnosticReplayGate": { "const": "passed" }
        },
        "required": ["formalDiagnosticReplayGate"]
      },
      "then": {
        "properties": {
          "diagnosticCompleteness": {
            "properties": {
              "status": { "const": "passed" },
              "reasons": { "maxItems": 0 }
            }
          },
          "equivalenceAssessment": {
            "properties": {
              "status": { "const": "passed" },
              "staticSemanticEquivalent": { "const": true }
            }
          },
          "artifactTransferStatus": { "const": "passed" }
        }
      }
    },
    {
      "if": {
        "properties": { "formalControlGate": { "const": "passed" } },
        "required": ["formalControlGate"]
      },
      "then": {
        "properties": {
          "qualityAssessment": {
            "properties": { "status": { "const": "passed" } }
          }
        }
      }
    }
  ],
  "$defs": {
    "terminationReason": {
      "enum": [
        "joint_limit",
        "fall_height",
        "fall_upright",
        "nonfinite"
      ]
    },
    "internalArtifact": {
      "type": "object",
      "required": ["path", "digest", "sizeBytes", "distribution"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "not": { "pattern": "(^/|(^|/)\\.\\.(/|$))" }
        },
        "digest": { "$ref": "common.schema.json#/$defs/digest" },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "distribution": { "const": "internal_only" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
