{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldspec.dev/schemas/0.1/h1-locomotion-training-profile.schema.json",
  "title": "WorldSpec H1 Locomotion Training Profile 0.1",
  "type": "object",
  "required": [
    "id",
    "profileVersion",
    "route",
    "framework",
    "target",
    "runtime",
    "training",
    "control",
    "curriculum",
    "validation",
    "outputs",
    "evidenceStatus"
  ],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "profileVersion": { "$ref": "common.schema.json#/$defs/semver" },
    "route": { "const": "target_dynamics_retraining" },
    "decisionRef": { "$ref": "common.schema.json#/$defs/id" },
    "framework": {
      "type": "object",
      "required": [
        "name",
        "sourceLockDigest",
        "sourceCommit",
        "physicsImplementation",
        "trainer",
        "referenceEnvironment",
        "targetEnvironmentAdapter",
        "decisionStatus"
      ],
      "properties": {
        "name": { "const": "mujoco_playground" },
        "sourceLockDigest": { "$ref": "common.schema.json#/$defs/digest" },
        "sourceCommit": {
          "const": "124a73fa3303f75a62f8fe04d329b829ed0ebdfb"
        },
        "physicsImplementation": { "const": "warp" },
        "trainer": { "const": "brax_jax_ppo" },
        "referenceEnvironment": { "const": "H1JoystickGaitTracking" },
        "targetEnvironmentAdapter": {
          "const": "worldspec_h1_loaded_velocity_v1"
        },
        "decisionStatus": { "const": "accepted" }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": [
        "sourceLockDigest",
        "compositionProfileDigest",
        "bundleDigest",
        "baseRobotComponent",
        "effector",
        "gripperCount"
      ],
      "properties": {
        "sourceLockDigest": { "$ref": "common.schema.json#/$defs/digest" },
        "compositionProfileDigest": { "$ref": "common.schema.json#/$defs/digest" },
        "bundleDigest": { "$ref": "common.schema.json#/$defs/digest" },
        "baseRobotComponent": { "$ref": "common.schema.json#/$defs/id" },
        "effector": { "$ref": "common.schema.json#/$defs/id" },
        "gripperCount": { "const": 1 }
      },
      "additionalProperties": false
    },
    "training": {
      "type": "object",
      "required": [
        "hyperparameterStatus",
        "seed",
        "numTimesteps",
        "numEnvs",
        "numEvals",
        "episodeLength",
        "simulationTimestepSeconds",
        "unrollLength",
        "numMinibatches",
        "numUpdatesPerBatch",
        "batchSize",
        "learningRate",
        "discounting",
        "entropyCost",
        "matmulPrecision",
        "commandDistribution"
      ],
      "properties": {
        "hyperparameterStatus": {
          "const": "imported_baseline_unvalidated"
        },
        "seed": { "type": "integer", "minimum": 0 },
        "numTimesteps": { "type": "integer", "minimum": 1 },
        "numEnvs": { "type": "integer", "minimum": 1 },
        "numEvals": { "type": "integer", "minimum": 1 },
        "episodeLength": { "type": "integer", "minimum": 1 },
        "simulationTimestepSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unrollLength": { "type": "integer", "minimum": 1 },
        "numMinibatches": { "type": "integer", "minimum": 1 },
        "numUpdatesPerBatch": { "type": "integer", "minimum": 1 },
        "batchSize": { "type": "integer", "minimum": 1 },
        "learningRate": { "type": "number", "exclusiveMinimum": 0 },
        "discounting": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "entropyCost": { "type": "number", "minimum": 0 },
        "matmulPrecision": { "const": "highest" },
        "commandDistribution": {
          "type": "object",
          "required": [
            "linearVelocityX",
            "linearVelocityY",
            "angularVelocityYaw",
            "zeroCommandProbability"
          ],
          "properties": {
            "linearVelocityX": { "$ref": "#/$defs/range2" },
            "linearVelocityY": { "$ref": "#/$defs/range2" },
            "angularVelocityYaw": { "$ref": "#/$defs/range2" },
            "zeroCommandProbability": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": [
        "engine",
        "algorithm",
        "status",
        "targetPlatform",
        "minimumGpuCount",
        "mjxCapacity"
      ],
      "properties": {
        "engine": { "const": "mujoco_mjx" },
        "algorithm": { "const": "ppo" },
        "status": { "enum": ["planned", "locked"] },
        "targetPlatform": { "const": "linux_x86_64_nvidia" },
        "minimumGpuCount": { "type": "integer", "minimum": 1 },
        "containerDigest": { "$ref": "common.schema.json#/$defs/digest" },
        "backendPackage": { "const": "worldspec_h1_training" },
        "backendVersion": { "$ref": "common.schema.json#/$defs/semver" },
        "packageLockDigest": { "$ref": "common.schema.json#/$defs/digest" },
        "mjxCapacity": {
          "type": "object",
          "required": ["naconmax", "naccdmax", "njmax"],
          "properties": {
            "naconmax": { "type": "integer", "minimum": 64 },
            "naccdmax": { "type": "integer", "minimum": 64 },
            "njmax": { "type": "integer", "minimum": 512 }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "locked" } },
            "required": ["status"]
          },
          "then": {
            "required": [
              "containerDigest",
              "backendPackage",
              "backendVersion",
              "packageLockDigest"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "teacherPolicy": {
      "type": "object",
      "required": ["digest", "usage", "behaviorOnTarget"],
      "properties": {
        "digest": { "$ref": "common.schema.json#/$defs/digest" },
        "usage": {
          "enum": [
            "interface_reference",
            "initialization_candidate",
            "distillation_candidate"
          ]
        },
        "behaviorOnTarget": { "const": "failed" }
      },
      "additionalProperties": false
    },
    "control": {
      "type": "object",
      "required": [
        "baselineProfileDigest",
        "policyJoints",
        "policyActuators",
        "policyKps",
        "policyKds",
        "defaultAngles",
        "actionScale",
        "heldJoints",
        "heldActuators",
        "heldTargets",
        "heldKps",
        "heldKds",
        "gripperActuators",
        "gripperCommands",
        "controlDecimation"
      ],
      "properties": {
        "baselineProfileDigest": { "$ref": "common.schema.json#/$defs/digest" },
        "policyJoints": { "$ref": "#/$defs/nameArray" },
        "policyActuators": { "$ref": "#/$defs/nameArray" },
        "policyKps": { "$ref": "#/$defs/numberArray" },
        "policyKds": { "$ref": "#/$defs/numberArray" },
        "defaultAngles": { "$ref": "#/$defs/numberArray" },
        "actionScale": { "type": "number", "exclusiveMinimum": 0 },
        "heldJoints": { "$ref": "#/$defs/nameArray" },
        "heldActuators": { "$ref": "#/$defs/nameArray" },
        "heldTargets": { "$ref": "#/$defs/numberArray" },
        "heldKps": { "$ref": "#/$defs/numberArray" },
        "heldKds": { "$ref": "#/$defs/numberArray" },
        "gripperActuators": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true
        },
        "gripperCommands": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 1,
          "maxItems": 1
        },
        "controlDecimation": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "curriculum": {
      "type": "object",
      "required": ["stages", "randomizationPolicy"],
      "properties": {
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "objective", "exitGate"],
            "properties": {
              "id": { "$ref": "common.schema.json#/$defs/id" },
              "objective": {
                "enum": [
                  "stand",
                  "velocity_tracking",
                  "loaded_velocity_tracking",
                  "stop_and_settle"
                ]
              },
              "exitGate": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          "minItems": 4,
          "maxItems": 4,
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": { "objective": { "const": "stand" } },
                "required": ["objective"]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": { "objective": { "const": "velocity_tracking" } },
                "required": ["objective"]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": { "objective": { "const": "loaded_velocity_tracking" } },
                "required": ["objective"]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": { "objective": { "const": "stop_and_settle" } },
                "required": ["objective"]
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        },
        "randomizationPolicy": {
          "enum": ["disabled_until_nominal_pass", "bounded_after_nominal_pass"]
        }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "required": [
        "nominalDurationSeconds",
        "minimumBaseHeight",
        "minimumUprightCosine",
        "minimumForwardDisplacement",
        "maximumLateralDrift",
        "settleWindowSeconds",
        "maximumSettleLinearSpeed",
        "maximumSettleAngularSpeed",
        "maximumJointLimitViolations",
        "maximumNonFiniteSamples",
        "requiredConsecutivePasses"
      ],
      "properties": {
        "nominalDurationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "minimumBaseHeight": { "type": "number", "minimum": 0 },
        "minimumUprightCosine": { "type": "number", "minimum": -1, "maximum": 1 },
        "minimumForwardDisplacement": { "type": "number", "minimum": 0 },
        "maximumLateralDrift": { "type": "number", "minimum": 0 },
        "settleWindowSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "maximumSettleLinearSpeed": { "type": "number", "minimum": 0 },
        "maximumSettleAngularSpeed": { "type": "number", "minimum": 0 },
        "maximumJointLimitViolations": { "type": "integer", "minimum": 0 },
        "maximumNonFiniteSamples": { "type": "integer", "minimum": 0 },
        "requiredConsecutivePasses": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "outputs": {
      "type": "array",
      "items": {
        "enum": [
          "orbax_checkpoint_archive",
          "policy_manifest",
          "training_result",
          "evaluation_traces",
          "environment_lock"
        ]
      },
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true
    },
    "evidenceStatus": { "const": "derived" },
    "profileDigest": { "$ref": "common.schema.json#/$defs/digest" }
  },
  "$defs": {
    "nameArray": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "numberArray": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 1
    },
    "range2": {
      "type": "array",
      "prefixItems": [
        { "type": "number" },
        { "type": "number" }
      ],
      "minItems": 2,
      "maxItems": 2
    }
  },
  "additionalProperties": false
}
