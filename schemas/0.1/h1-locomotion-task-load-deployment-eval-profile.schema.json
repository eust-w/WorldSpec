{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldspec.dev/schemas/0.1/h1-locomotion-task-load-deployment-eval-profile.schema.json",
  "title": "WorldSpec H1 Task-Load Deployment Evaluation Profile 0.1",
  "type": "object",
  "required": [
    "id",
    "profileVersion",
    "status",
    "stage",
    "baseTrainingProfileDigest",
    "a5ckEvidence",
    "priorAttempt",
    "runtime",
    "warmStart",
    "standTeacher",
    "settleTeacher",
    "trainingOverrides",
    "checkpointSelection",
    "environment",
    "qualityGates",
    "artifactPolicy",
    "evidenceStatus"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "profileVersion": {
      "const": "0.1.0"
    },
    "status": {
      "const": "research"
    },
    "stage": {
      "const": "loaded_track_settle_task_load_deployment_eval"
    },
    "baseTrainingProfileDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "a5ckEvidence": {
      "type": "object"
    },
    "priorAttempt": {
      "type": "object",
      "required": [
        "sourceStage",
        "sourceReportDigest",
        "sourceReportSizeBytes",
        "checkpointDigest",
        "checkpointSizeBytes",
        "formalTrainingGate",
        "distribution"
      ],
      "properties": {
        "sourceStage": {
          "const": "loaded-track-settle-task-load-survival-v3-failed"
        },
        "sourceReportDigest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "sourceReportSizeBytes": {
          "type": "integer",
          "minimum": 1
        },
        "checkpointDigest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "checkpointSizeBytes": {
          "type": "integer",
          "minimum": 1
        },
        "formalTrainingGate": {
          "const": "failed"
        },
        "distribution": {
          "const": "internal_only"
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": [
        "containerImage",
        "containerDigest",
        "packageLockDigest",
        "ccdIterations"
      ],
      "properties": {
        "containerImage": {
          "type": "string",
          "pattern": "^\\S+@sha256:[0-9a-f]{64}$"
        },
        "containerDigest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "packageLockDigest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "ccdIterations": {
          "const": 50
        }
      },
      "additionalProperties": false
    },
    "warmStart": {
      "type": "object"
    },
    "standTeacher": {
      "type": "object"
    },
    "settleTeacher": {
      "type": "object"
    },
    "trainingOverrides": {
      "type": "object",
      "required": [
        "numTimesteps",
        "numEnvs",
        "numEvals",
        "episodeLength",
        "learningRate",
        "entropyCost",
        "deterministicEval"
      ],
      "properties": {
        "deterministicEval": {
          "const": true
        }
      }
    },
    "checkpointSelection": {
      "type": "object",
      "required": [
        "includeWarmStart"
      ],
      "properties": {
        "includeWarmStart": {
          "const": true
        }
      }
    },
    "environment": {
      "type": "object",
      "required": [
        "commandDistribution",
        "transitionCurriculum",
        "taskLoadCurriculum",
        "termination",
        "reward",
        "targets",
        "sigmas",
        "commandResampleSteps"
      ],
      "properties": {
        "commandDistribution": {
          "type": "object"
        },
        "transitionCurriculum": {
          "type": "object"
        },
        "taskLoadCurriculum": {
          "type": "object"
        },
        "termination": {
          "type": "object"
        },
        "reward": {
          "type": "object",
          "required": [
            "terminationPenalty",
            "standTeacherActionCost",
            "settleTeacherActionCost"
          ],
          "properties": {
            "terminationPenalty": {
              "const": 25.0
            },
            "standTeacherActionCost": {
              "const": 1.0
            },
            "settleTeacherActionCost": {
              "const": 1.0
            }
          }
        },
        "targets": {
          "type": "object"
        },
        "sigmas": {
          "type": "object"
        },
        "commandResampleSteps": {
          "const": 200
        }
      }
    },
    "qualityGates": {
      "type": "object",
      "required": [
        "settleWindowSeconds",
        "settleMeasurementWindowSeconds",
        "maximumSettleLinearSpeed",
        "maximumSettleAngularSpeed",
        "minimumFinalMeanEpisodeLength"
      ],
      "properties": {
        "settleWindowSeconds": {
          "const": 1.0
        },
        "settleMeasurementWindowSeconds": {
          "const": 0.2
        },
        "maximumSettleLinearSpeed": {
          "const": 0.2
        },
        "maximumSettleAngularSpeed": {
          "const": 0.4
        },
        "minimumFinalMeanEpisodeLength": {
          "const": 900.0
        }
      }
    },
    "artifactPolicy": {
      "type": "object"
    },
    "evidenceStatus": {
      "const": "derived"
    }
  },
  "additionalProperties": false
}
