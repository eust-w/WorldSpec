{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldspec.dev/schemas/0.1/h1-whole-body-control-report.schema.json",
  "title": "WorldSpec H1 Whole-Body Task-Space Control Spike Report 0.1",
  "type": "object",
  "required": [
    "id",
    "reportVersion",
    "status",
    "scope",
    "executionEvidence",
    "runtimeAcceptance",
    "controllerStatus",
    "formalControlGate",
    "probeDefinition",
    "imageSource",
    "probeInput",
    "container",
    "platform",
    "gpu",
    "packages",
    "packageLockDigest",
    "baseTrainingProfileDigest",
    "supervisorProfileDigest",
    "controlProfileDigest",
    "policies",
    "staticPreflight",
    "runtimePreflight",
    "target",
    "scene",
    "controller",
    "qualityAssessment",
    "controllerArtifact",
    "traceArtifact",
    "claimBoundary",
    "logDiagnostics",
    "generatedAt"
  ],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "reportVersion": { "const": "0.1.0" },
    "status": { "const": "completed" },
    "scope": { "const": "h1_whole_body_task_space_control_spike" },
    "executionEvidence": { "const": "executed" },
    "runtimeAcceptance": { "const": "research_control_spike" },
    "controllerStatus": {
      "enum": ["control_candidate", "non_publishable"]
    },
    "formalControlGate": { "enum": ["passed", "failed"] },
    "probeDefinition": {
      "$ref": "h1-locomotion-midterm-report.schema.json#/$defs/revision"
    },
    "imageSource": {
      "$ref": "h1-locomotion-midterm-report.schema.json#/$defs/revision"
    },
    "probeInput": {
      "$ref": "h1-locomotion-dual-policy-report.schema.json#/$defs/probeInput"
    },
    "container": { "type": "object" },
    "platform": { "type": "object" },
    "gpu": { "type": "object" },
    "packages": { "type": "object" },
    "packageLockDigest": { "$ref": "common.schema.json#/$defs/digest" },
    "baseTrainingProfileDigest": { "$ref": "common.schema.json#/$defs/digest" },
    "supervisorProfileDigest": { "$ref": "common.schema.json#/$defs/digest" },
    "controlProfileDigest": { "$ref": "common.schema.json#/$defs/digest" },
    "policies": {
      "type": "object",
      "required": ["motion", "capture", "stand"],
      "additionalProperties": { "type": "object" }
    },
    "staticPreflight": { "type": "object" },
    "runtimePreflight": { "type": "object" },
    "target": { "type": "object" },
    "scene": { "type": "object" },
    "controller": { "type": "object" },
    "taskPolicyHandoff": {
      "$ref": "h1-whole-body-control-profile.schema.json#/properties/taskPolicyHandoff"
    },
    "dynamicArmTracking": {
      "$ref": "h1-whole-body-control-profile.schema.json#/properties/dynamicArmTracking"
    },
    "taskGeometryCalibration": {
      "$ref": "h1-whole-body-control-profile.schema.json#/properties/taskGeometryCalibration"
    },
    "qualityAssessment": {
      "type": "object",
      "required": ["status", "tests"],
      "properties": {
        "status": { "enum": ["passed", "failed"] },
        "tests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "result", "metrics"],
            "properties": {
              "id": { "$ref": "common.schema.json#/$defs/id" },
              "result": { "enum": ["pass", "fail"] },
              "metrics": { "type": "object" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "controllerArtifact": {
      "$ref": "h1-locomotion-dual-policy-report.schema.json#/$defs/artifact"
    },
    "traceArtifact": {
      "$ref": "h1-locomotion-dual-policy-report.schema.json#/$defs/artifact"
    },
    "claimBoundary": {
      "const": {
        "status": "control_spike_only",
        "fullTaskClaim": "forbidden",
        "l3Claim": "forbidden",
        "reasons": [
          "only_handle_tracking_is_evaluated",
          "whole_body_control_is_not_yet_validated_for_physical_grasp",
          "right_gripper_mount_evidence_is_estimated"
        ]
      }
    },
    "logDiagnostics": {
      "$ref": "h1-locomotion-dual-policy-report.schema.json#/$defs/logDiagnostics"
    },
    "generatedAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "formalControlGate": { "const": "passed" } },
        "required": ["formalControlGate"]
      },
      "then": {
        "properties": {
          "controllerStatus": { "const": "control_candidate" },
          "qualityAssessment": {
            "properties": {
              "status": { "const": "passed" },
              "tests": {
                "not": {
                  "contains": {
                    "properties": { "result": { "const": "fail" } },
                    "required": ["result"]
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
