    "profileVersion",
    "status",
    "stage",
    "baseTrainingProfileDigest",
    "motionPolicy",
    "capturePolicy",
    "standPolicy",
    "evaluationEnvironment",
    "supervisor",
    "qualityGates",
    "runtime",
    "artifactPolicy"
  ],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "profileVersion": { "const": "0.1.0" },
    "status": { "const": "research" },
    "stage": { "const": "task_load_phase_aware_supervisor_probe" },
